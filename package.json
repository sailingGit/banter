{
  "name": "live-chat-copilot",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.js",
    "test:e2e": "npm run build && node test/e2e/run.mjs",
    "smoke": "node --env-file-if-exists=.env.local test/smoke.mjs",
    "demo": "npm run build && node test/demo/record.mjs",
    "package": "npm run build && mkdir -p release && rm -f release/live-chat-copilot-$npm_package_version.zip && cd dist && zip -qrX ../release/live-chat-copilot-$npm_package_version.zip ."
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "ws": "^8.18.0"
  },
  "license": "MIT"
}
